PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=https://files.yourdomain.com

DB_HOST=localhost
DB_PORT=3306
DB_USER=teamdrive
DB_PASSWORD=secret
DB_NAME=teamdrive

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=teamdrive

# Max upload size in MB
MAX_UPLOAD_MB=2048

# Days to keep files in storage after "Delete forever"
PURGE_DAYS=30

# Largest folder that can be downloaded as a zip, in MB
MAX_ZIP_MB=5120

# Two-step login requirement: admins | all | none
REQUIRE_2FA=admins

# Teams: name for the first team on upgrade, and who becomes the TeamDrive owner (default: earliest admin)
TEAM_NAME=My team
# OWNER_EMAIL=you@yourdomain.com

# Days to keep the activity log
ACTIVITY_DAYS=365

# Legal pages (/terms, /privacy)
LEGAL_NAME=Equawire
LEGAL_OPERATOR=Equawire, Ontario, Canada
LEGAL_EMAIL=privacy@equawire.com
LEGAL_UPDATED=October 30, 2026

# Public demo (only on your own demo/marketing site, never on a client's copy)
# DEMO_MODE=1
# DEMO_RESET_HOUR=3

# Set to 0 on clients' private copies so / opens the sign-in page instead of the Equawire landing page
# LANDING_PAGE=0

# Optional: S3-compatible storage other than Cloudflare R2 (e.g. DigitalOcean Spaces Toronto)
# R2_ENDPOINT=https://tor1.digitaloceanspaces.com

# Database backups (to the storage bucket, under backups/<DB_NAME>/)
# BACKUPS=1
# BACKUP_HOUR=2
# BACKUP_KEEP_DAYS=30

# Client portal (Clients tab and /portal for your clients)
# PORTAL=1
# Email for invites and reminders (needed for the portal to email clients)
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=Your Firm <no-reply@yourdomain.com>
